Package: diffcp
Type: Package
Title: Differentiating Through Cone Programs
Version: 0.1.0
Authors@R: c(
    person("Balasubramanian", "Narasimhan",
           role = c("aut", "cre"),
           email = "naras@stanford.edu"),
    person("Akshay", "Agrawal", role = "aut"),
